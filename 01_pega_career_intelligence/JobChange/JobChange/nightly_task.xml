      <Command>C:\Users\DNSATHV\AppData\Local\Programs\Python\Python312\python.exe</Command>
      <Arguments>-B "C:\Users\DNSATHV\Desktop\calude\01_pega_career_intelligence\JobChange\JobChange\nightly_scan.py"</Arguments>
      <WorkingDirectory>C:\Users\DNSATHV\Desktop\calude\01_pega_career_intelligence\JobChange\JobChange</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
